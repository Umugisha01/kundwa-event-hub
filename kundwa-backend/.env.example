# Django Secret Key (generate a strong one for production)
SECRET_KEY=django-insecure-change-me-in-production

# Debug mode (set to False in production)
DEBUG=False

# Allowed hosts (comma separated or * for testing)
ALLOWED_HOSTS=kundwa-backend.onrender.com,localhost,127.0.0.1

# Optional Database URL (PostgreSQL provided by Render, Supabase, Neon, etc.)
# If not provided, Django falls back to SQLite db.sqlite3
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# CORS Allowed Origins (comma separated list of frontend URLs)
CORS_ALLOWED_ORIGINS=https://kundwa.vercel.app,http://localhost:8080,http://localhost:5173
